from datetime import datetime as DateTime
from datetime import timedelta as TimeDelta
from typing import ClassVar

class PyExchange:
    Binance: ClassVar[PyExchange]
    Bybit: ClassVar[PyExchange]
    Moex: ClassVar[PyExchange]
    Spb: ClassVar[PyExchange]

    @staticmethod
    def all() -> list[PyExchange]: ...
    @staticmethod
    def from_str(s: str) -> PyExchange: ...
    def display(self) -> str: ...
    def eq(self, other: PyExchange) -> bool: ...
    def key(self) -> str: ...

class PyCategory:
    Index: ClassVar[PyCategory]
    Share: ClassVar[PyCategory]
    Future: ClassVar[PyCategory]
    Bond: ClassVar[PyCategory]
    Option: ClassVar[PyCategory]
    Etf: ClassVar[PyCategory]
    CurrencyPair: ClassVar[PyCategory]

    @staticmethod
    def all() -> list[PyCategory]: ...
    @staticmethod
    def from_str(s: str) -> PyCategory: ...
    def display(self) -> str: ...
    def eq(self, other: PyCategory) -> bool: ...
    def key(self) -> str: ...

class PyTicker:
    def __init__(self, value: str) -> None: ...
    @staticmethod
    def from_str(s: str) -> PyTicker: ...
    def display(self) -> str: ...
    def eq(self, other: PyTicker) -> bool: ...

class PyInstrumentId:
    def __init__(
        self,
        exchange: PyExchange,
        category: PyCategory,
        ticker: PyTicker,
    ) -> None: ...
    @staticmethod
    def from_str(s: str) -> PyInstrumentId: ...
    def display(self) -> str: ...
    def eq(self, other: PyInstrumentId) -> bool: ...
    def exchange(self) -> PyExchange: ...
    def category(self) -> PyCategory: ...
    def ticker(self) -> PyTicker: ...

class PyInstrumentInfo:
    def iid(self) -> PyInstrumentId: ...
    def exchange(self) -> PyExchange: ...
    def category(self) -> PyCategory: ...
    def ticker(self) -> PyTicker: ...
    def figi(self) -> str: ...
    def name(self) -> str: ...
    def lot(self) -> int: ...
    def step(self) -> float: ...
    def raw_info(self) -> dict[str, str]: ...

class PyInstrumentList:
    def __init__(self) -> None: ...
    def is_empty(self) -> bool: ...
    def len(self) -> int: ...
    def iter(self) -> list[PyInstrumentInfo]: ...
    def add(self, instrument: PyInstrumentInfo) -> None: ...
    def find(self, iid: PyInstrumentId) -> PyInstrumentInfo | None: ...

class PyWatchlistGroup:
    def __init__(self, name: str) -> None: ...
    def name(self) -> str: ...
    def instruments(self) -> list[PyInstrumentId]: ...
    def is_empty(self) -> bool: ...
    def len(self) -> int: ...
    def get(self, n: int) -> PyInstrumentId | None: ...

class PyWatchlistItem:
    @staticmethod
    def from_instrument(iid: PyInstrumentId) -> PyWatchlistItem: ...
    @staticmethod
    def from_group(group: PyWatchlistGroup) -> PyWatchlistItem: ...
    def instrument(self) -> PyInstrumentId | None: ...
    def group(self) -> PyWatchlistGroup | None: ...

class PyWatchlist:
    def __init__(self, name: str) -> None: ...
    def name(self) -> str: ...
    def items(self) -> list[PyWatchlistItem]: ...
    def is_empty(self) -> bool: ...
    def len(self) -> int: ...
    def get(self, n: int) -> PyWatchlistItem | None: ...

class PyPriceRange:
    def __init__(self, low: float, high: float) -> None: ...
    def display(self) -> str: ...
    def eq(self, other: PyPriceRange) -> bool: ...
    def low(self) -> float: ...
    def high(self) -> float: ...
    def contains(self, value: float) -> bool: ...
    def middle(self) -> float: ...
    def width(self) -> float: ...

class PyBarDirection:
    Bull: ClassVar[PyBarDirection]
    Neutral: ClassVar[PyBarDirection]
    Bear: ClassVar[PyBarDirection]

    def display(self) -> str: ...
    def eq(self, other: PyBarDirection) -> bool: ...
    def value(self) -> int: ...

class PyBar:
    def __init__(
        self, ts: int, o: float, h: float, l: float, c: float, v: int
    ) -> None: ...
    def ts(self) -> int: ...
    def o(self) -> float: ...
    def h(self) -> float: ...
    def l(self) -> float: ...
    def c(self) -> float: ...
    def v(self) -> int: ...
    def display(self) -> str: ...
    def eq(self, other: PyBar) -> bool: ...
    def dt(self) -> DateTime: ...
    def direction(self) -> PyBarDirection: ...
    def is_bear(self) -> bool: ...
    def is_bull(self) -> bool: ...
    def is_neutral(self) -> bool: ...
    def range(self) -> PyPriceRange: ...
    def body(self) -> PyPriceRange: ...
    def lower(self) -> PyPriceRange: ...
    def upper(self) -> PyPriceRange: ...
    def contains(self, price: float) -> bool: ...

class PyTimeFrame:
    S1: ClassVar[PyTimeFrame]
    S5: ClassVar[PyTimeFrame]
    S10: ClassVar[PyTimeFrame]
    S15: ClassVar[PyTimeFrame]
    M1: ClassVar[PyTimeFrame]
    M5: ClassVar[PyTimeFrame]
    M10: ClassVar[PyTimeFrame]
    M15: ClassVar[PyTimeFrame]
    H1: ClassVar[PyTimeFrame]
    H4: ClassVar[PyTimeFrame]
    Day: ClassVar[PyTimeFrame]
    Week: ClassVar[PyTimeFrame]
    Month: ClassVar[PyTimeFrame]

    @staticmethod
    def all() -> list[PyTimeFrame]: ...
    @staticmethod
    def from_str(s: str) -> PyTimeFrame: ...
    def display(self) -> str: ...
    def eq(self, other: PyTimeFrame) -> bool: ...
    def key(self) -> str: ...
    def nanos(self) -> int | None: ...
    def seconds(self) -> int | None: ...
    def timedelta(self) -> TimeDelta | None: ...
    def begin_frame_ts(self, ts: int) -> int: ...
    def end_frame_ts(self, ts: int) -> int: ...

class PyChart:
    def __init__(
        self,
        iid: PyInstrumentId,
        tf: PyTimeFrame,
        bars: list[PyBar],
    ) -> None: ...
    @staticmethod
    def empty(iid: PyInstrumentId, tf: PyTimeFrame) -> PyChart: ...
    def iid(self) -> PyInstrumentId: ...
    def ticker(self) -> PyTicker: ...
    def tf(self) -> PyTimeFrame: ...
    def len(self) -> int: ...
    def is_empty(self) -> bool: ...
    def bars(self) -> list[PyBar]: ...
    def bar(self, index: int) -> PyBar | None: ...
    def first(self) -> PyBar | None: ...
    def last(self) -> PyBar | None: ...
    def last_price(self) -> float | None: ...
    def select(self, from_ts: int, till_ts: int) -> list[PyBar]: ...
    def upsert(self, bar: PyBar) -> None: ...
